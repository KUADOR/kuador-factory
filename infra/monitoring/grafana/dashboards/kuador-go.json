    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "instant": true,
     "format": "table",
     "expr": "topk(10, sum by (method, uri) (increase(http_server_requests_seconds_sum{job=\"kuador-api\", uri!~\"/actuator.*|/livez|/readyz|/api/live.*\"}[1h])) / sum by (method, uri) (increase(http_server_requests_seconds_count{job=\"kuador-api\", uri!~\"/actuator.*|/livez|/readyz|/api/live.*\"}[1h])) > 0)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 3
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "method": "Método",
       "uri": "Ruta",
       "Value": "Promedio"
      }
     }
    },
    {
     "id": "sortBy",
     "options": {
      "sort": [
       {
        "field": "Promedio",
        "desc": true
       }
      ]
     }
    }
   ],
   "options": {
    "showHeader": true
   }
