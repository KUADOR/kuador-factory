# Copia a .env (no se versiona). Se usa solo si aún no existe ninguna cuenta:
# crea el acceso de la primera persona del equipo para poder entrar al tablero.
BOARD_BOOTSTRAP_ADMIN_EMAIL=admin@kuador.local
BOARD_BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave-larga

# Carpetas donde el tablero puede leer y escribir documentos de repositorios locales (coma = varias).
BOARD_SYNC_ALLOWED_ROOTS=/Users/tu-usuario/workspace

# Clave para cifrar los tokens de GitHub guardados (openssl rand -base64 32). Si cambia, hay que
# volver a vincular los repositorios.
BOARD_SECRETS_KEY=

# Agentes (Claude). Sin clave quedan desactivados. Cada asignación a un agente consume tokens.
ANTHROPIC_API_KEY=

# Correo para los códigos de verificación del alta de espacios (SMTP del proveedor).
# spring.mail.host=smtp.ejemplo.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# spring.mail.properties.mail.smtp.starttls.enable=true
BOARD_MAIL_FROM=Kuador Factory <no-reply@kuador.com>
# Solo desarrollo: sin SMTP, el código se escribe en el log de la API. Nunca en producción.
BOARD_MAIL_LOG_CODES=false

# URL con la que los clientes de IA llegan al MCP (/mcp) y GitHub a sus webhooks. En el VPS, el dominio público.
BOARD_PUBLIC_URL=http://localhost:8091
# URL del tablero web. La GitHub App vuelve ahí al registrarse o instalarse.
BOARD_WEB_URL=http://localhost:3600
